generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  role      Role      @default(EMPLOYEE)
  createdAt DateTime  @default(now())
  name      String
  employee  Employee?

  tradingAccount  TradingAccount?
  tradingPositions TradingPosition[]
  tradingOrders   TradingOrder[]
}

model Employee {
  id           String     @id @default(cuid())
  name         String
  position     String
  phone        String?
  gender       Gender?
  birthDate    DateTime?
  address      String?

  joinDate     DateTime?

  emergencyContact String?
  emergencyPhone   String?

  bankName     String?
  bankAccount  String?

  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  leaves       Leave[]

  attendance Attendance[]
  payrolls   Payroll[]
  laporans   Laporan[]
  ejos       Ejo[]

  createdAt    DateTime @default(now())
}

enum Gender {
  MALE
  FEMALE
}

model Department {
  id        String     @id @default(cuid())
  name      String
  jobdesk   String
  plant     String
  createdAt DateTime   @default(now())
  employees Employee[]
}

model Leave {
  id         String      @id @default(cuid())
  leaveType  LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}


model Attendance {
  id         String   @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  date       DateTime

  checkIn    DateTime?
  checkOut   DateTime?

  status     AttendanceStatus @default(PRESENT)

  createdAt  DateTime @default(now())
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

enum PayrollStatus {
  PENDING
  PAID
}

model Payroll {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])

  month         Int
  year          Int

  baseSalary    Float
  allowance     Float         @default(0)
  deduction     Float         @default(0)
  bonus         Float         @default(0)
  totalSalary   Float

  status        PayrollStatus @default(PENDING)
  paidAt        DateTime?
  notes         String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([employeeId, month, year])
  @@index([month, year])
  @@index([status])
  @@index([employeeId])
}

model Ejo {
  id              String   @id @default(cuid())
  nomorEjo        Int      @default(autoincrement())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  divisi          Int
  department      String
  nomorMesin      Int
  grub            String
  jenisKerusakan  String
  jenisPerbaikan  String   // "MEKANIK" or "ELEKTRIK"
  jamKerusakan    DateTime
  namaPart        String
  picOperator     String

  status          String   @default("MENUNGGU_KONFIRMASI")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
  @@unique([nomorEjo])
}

model Laporan {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  alatUkurMeter   String
  alatUkurBusur   String
  inputAPB        Float
  noSpek          String
  sudut           Float
  lebar           Float
  kodeTreatment   String
  tanggalProduksi DateTime
  expire          DateTime
  lebarAktual     Float
  sudutAktual     Float
  jumlahRoll      Int
  meter           Float

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
}

// ============================================================
// PAPER TRADING — modul /trading (data pasar real, eksekusi simulasi)
// Port dari tradernext.vercel.app oleh Jarvis
// ============================================================

enum PositionSide {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

enum OrderStatus {
  PENDING
  TRIGGERED
  FILLED
  CANCELLED
}

model TradingAccount {
  id        String   @id
  userId    String   @unique
  balance   Float    @default(10000)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradingPosition {
  id          String         @id
  userId      String
  symbol      String
  side        PositionSide
  qty         Float
  entryPrice  Float
  leverage    Int            @default(1)
  slPrice     Float?
  tpPrice     Float?
  status      PositionStatus @default(OPEN)
  openedAt    DateTime       @default(now())
  closedAt    DateTime?
  closePrice  Float?
  realizedPnl Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model TradingOrder {
  id             String      @id
  userId         String
  symbol         String
  side           PositionSide
  type           OrderType
  qty            Float
  price          Float?
  leverage       Int         @default(1)
  slPrice        Float?
  tpPrice        Float?
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  filledAt       DateTime?
  triggeredPrice Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
