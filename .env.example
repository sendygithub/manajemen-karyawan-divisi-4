# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit .env — file ini hanya template placeholder.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/hr_db"

# Secret untuk next-auth (generate dengan: openssl rand -base64 32)
NEXTAUTH_SECRET="ganti-dengan-random-string-panjang"

# URL aplikasi (wajib untuk next-auth di production)
NEXTAUTH_URL="http://localhost:3000"
